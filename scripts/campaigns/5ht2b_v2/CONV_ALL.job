#!/bin/bash
#SBATCH --job-name="CONV_ALL"
#SBATCH --output="/expanse/lustre/projects/iit127/fcetin/5ht2b/v2/logs/retro/CONV_ALL.%j.out"
#SBATCH --partition=debug --nodes=1 --ntasks=1 --cpus-per-task=8 --mem=64G --account=iit127 -t 00:30:00
# Latest-checkpoint convergence verdict for the given v2 systems (one report each).
export JAX_PLATFORMS=cpu XLA_FLAGS="--xla_force_host_platform_device_count=1" OPENBLAS_NUM_THREADS=8 OMP_NUM_THREADS=8 PYTHONPATH=/home/fcetin/ChiMPSS/src
V2=/expanse/lustre/projects/iit127/fcetin/5ht2b/v2
echo "CONV_ALL | ChiMPSS $(cd /home/fcetin/ChiMPSS && git rev-parse --short HEAD) | $(date)"
for s in "$@"; do
  n=$(ls $V2/fultonmarket/$s/saved_variables | wc -l)
  /home/fcetin/miniconda3/envs/chimpss/bin/python -u -m chimpss.cli.convergence $V2/fultonmarket/$s $V2/equil_hmr/$s/step_5.pdb \
     --checkpoints $n --out $V2/logs/retro/convergence_${s}_$(date +%Y%m%d).json 2>&1 \
     | grep --line-buffered -E 'segments,|segs\]|Traceback|Error'
done
