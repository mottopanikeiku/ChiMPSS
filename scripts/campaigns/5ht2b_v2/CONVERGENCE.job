#!/bin/bash
#SBATCH --job-name="CONV"
#SBATCH --output="/expanse/lustre/projects/iit127/fcetin/5ht2b/v2/logs/retro/CONV.%x.%j.out"
#SBATCH --partition=shared --nodes=1 --ntasks=1 --cpus-per-task=8 --mem=96G --account=iit127 -t 08:00:00
# Usage: sbatch CONVERGENCE.job <fultonmarket_dir> <topology_pdb> [extra chimpss-convergence args]
export JAX_PLATFORMS=cpu XLA_FLAGS="--xla_force_host_platform_device_count=1"
export OPENBLAS_NUM_THREADS=8 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
export PYTHONPATH=/home/fcetin/ChiMPSS/src
echo "CONV $* | $(date) | $(cd /home/fcetin/ChiMPSS && git rev-parse --short HEAD)"
/usr/bin/time -v /home/fcetin/miniconda3/envs/chimpss/bin/python -m chimpss.cli.convergence "$@" 2>&1 | grep -vE '^\*|PyMBAR will|JAX is|MAY cause|uses of JAX|requires 64-bit|which is its default|enable JAX'
